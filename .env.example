# GEMINI_API_KEY: Required for Gemini AI API calls (Image Generation / Nano Banana).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OpenRouter Configuration (Primary & Exclusive Data Retrieval / Analysis / Text)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_VISION_MODEL="nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_TEXT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

